# Local development placeholders only. Never put real secrets in this file.
BUSINESS_PORT=8000
BUSINESS_DATABASE_URL=postgresql://business_user:change_me@localhost:5432/business_db

# Public half of the auth service's RS256 key pair. Provide a path or the PEM content, never both.
JWT_PUBLIC_KEY_PATH=../auth-service/secrets/jwt-public.pem
JWT_ISSUER=engine-repair-auth
JWT_AUDIENCE=engine-repair-api
JWT_ALLOWED_ALGORITHM=RS256

CORS_ORIGINS=http://localhost:5173

# Optional: disposable database for the PostgreSQL integration tests.
# TEST_DATABASE_URL=postgresql://business_user:change_me@localhost:5432/business_test
