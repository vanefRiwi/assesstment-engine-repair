# Local development placeholders only. Never put real secrets in this file.
# Generate a local RSA key pair outside version control.

# Authentication service (Express)
AUTH_PORT=3001
AUTH_DATABASE_URL=postgresql://auth_user:change_me@localhost:5432/auth_db
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_KEY_ID=local-dev-key-1
JWT_ISSUER=engine-repair-auth
JWT_AUDIENCE=engine-repair-api
JWT_EXPIRES_IN=15m

# Business service (FastAPI) receives the public key only
BUSINESS_PORT=8000
BUSINESS_DATABASE_URL=postgresql://business_user:change_me@localhost:5432/business_db
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=engine-repair-auth
JWT_AUDIENCE=engine-repair-api
JWT_ALLOWED_ALGORITHM=RS256

# Frontend
VITE_AUTH_API_URL=http://localhost:3001/api/v1
VITE_BUSINESS_API_URL=http://localhost:8000/api/v1