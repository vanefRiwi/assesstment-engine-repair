# Copy to .env for docker compose. Local development placeholders only: never commit real secrets.

# PostgreSQL superuser and one password per service role (created by docker/postgres/init-databases.sh)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
AUTH_DB_PASSWORD=change_me_auth
BUSINESS_DB_PASSWORD=change_me_business

# JWT: the RS256 key pair is generated automatically by the jwt-keys job into Docker volumes.
JWT_KEY_ID=local-dev-key-1

# First administrator, created on the first start only if no active admin exists.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-2026

# Image naming (CI publishes to ghcr.io/<owner>)
IMAGE_PREFIX=engine-repair
IMAGE_TAG=local

# Each service also has its own .env.example for running it outside Docker:
#   auth-service/.env.example, business-service/.env.example, frontend/.env.example
