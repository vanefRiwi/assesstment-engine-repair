# Local development placeholders only. Never put real secrets in this file.

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Authentication service
AUTH_PORT=3001
AUTH_DATABASE_URL=postgresql://auth_user:change_me@localhost:5432/auth_db
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_EXPIRES_IN=15m
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# Shared JWT validation settings (must match in both services)
JWT_ALGORITHM=RS256
JWT_ISSUER=engine-repair-auth
JWT_AUDIENCE=engine-repair-api

# Business service
BUSINESS_PORT=8000
BUSINESS_DATABASE_URL=postgresql://business_user:change_me@localhost:5432/business_db
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Frontend
VITE_AUTH_API_URL=http://localhost:3001
VITE_BUSINESS_API_URL=http://localhost:8000
