# Local development placeholders only. Never put real secrets in this file.
NODE_ENV=development
AUTH_PORT=3001
AUTH_DATABASE_URL=postgresql://auth_user:change_me@localhost:5432/auth_db

# RS256 signing key. Generate a local pair with `npm run keys:generate`.
# Provide either a file path or the PEM content (JWT_PRIVATE_KEY), never both.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_KEY_ID=local-dev-key-1
JWT_ISSUER=engine-repair-auth
JWT_AUDIENCE=engine-repair-api
JWT_EXPIRES_IN_SECONDS=900

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# First administrator, used only by `npm run admin:bootstrap`.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_please
